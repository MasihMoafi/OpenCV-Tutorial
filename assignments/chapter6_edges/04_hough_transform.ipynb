    "## 7. کاربرد عملی: تشخیص خطوط جاده / Practical Application: Lane Detection"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def detect_lane_lines(image: np.ndarray) -> np.ndarray:\n",
    "    \"\"\"\n",
    "    تشخیص خطوط جاده در تصویر\n",
    "    \n",
    "    Args:\n",
    "        image: تصویر ورودی (خاکستری)\n",
    "    \n",
    "    Returns:\n",
    "        تصویر با خطوط تشخیص داده شده\n",
    "    \"\"\"\n",
    "    # تشخیص لبه\n",
    "    # Edge detection\n",
    "    edges = cv2.Canny(image, 50, 150)\n",
    "    \n",
    "    # تعریف ناحیه مورد علاقه (ROI)\n",
    "    # Define region of interest (ROI)\n",
    "    height, width = image.shape\n",
    "    mask = np.zeros_like(edges)\n",
    "    \n",
    "    # مثلث برای ناحیه جاده\n",
    "    # Triangle for road region\n",
    "    polygon = np.array([[\n",
    "        (width * 0.1, height),\n",
    "        (width * 0.4, height * 0.6),\n",
    "        (width * 0.6, height * 0.6),\n",
    "        (width * 0.9, height)\n",
    "    ]], np.int32)\n",
    "    \n",
    "    cv2.fillPoly(mask, polygon, 255)\n",
    "    masked_edges = cv2.bitwise_and(edges, mask)\n",
    "    \n",
    "    # تشخیص خطوط\n",
    "    # Detect lines\n",
    "    lines = cv2.HoughLinesP(masked_edges,\n",
    "                            rho=1,\n",
    "                            theta=np.pi/180,\n",
    "                            threshold=50,\n",
    "                            minLineLength=100,\n",
    "                            maxLineGap=50)\n",
    "    \n",
    "    # رسم خطوط\n",
    "    # Draw lines\n",
    "    line_image = np.zeros_like(image)\n",
    "    \n",
    "    if lines is not None:\n",
    "        for line in lines:\n",
    "            x1, y1, x2, y2 = line[0]\n",
    "            cv2.line(line_image, (x1, y1), (x2, y2), 255, 5)\n",
    "    \n",
    "    return line_image, masked_edges\n",
    "\n",
    "\n",
    "# ایجاد تصویر شبیه‌سازی شده جاده\n",
    "# Create simulated road image\n",
    "road_image = np.zeros((400, 600), dtype=np.uint8)\n",
    "\n",
    "# خطوط جاده\n",
    "# Road lines\n",
    "cv2.line(road_image, (150, 400), (250, 200), 255, 3)\n",
    "cv2.line(road_image, (450, 400), (350, 200), 255, 3)\n",
    "cv2.line(road_image, (280, 400), (290, 250), 255, 2)\n",
    "cv2.line(road_image, (320, 400), (310, 250), 255, 2)\n",
    "\n",
    "# اعمال تشخیص\n",
    "# Apply detection\n",
    "lane_lines, masked = detect_lane_lines(road_image)\n",
    "\n",
    "# ترکیب با تصویر اصلی\n",
    "# Combine with original\n",
    "result = cv2.addWeighted(road_image, 0.8, lane_lines, 1, 0)\n",
    "\n",
    "display_images([road_image, masked, lane_lines, result],\n",
    "               ['تصویر اصلی\\nOriginal',\n",
    "                'ناحیه مورد علاقه\\nROI',\n",
    "                'خطوط تشخیص داده شده\\nDetected Lines',\n",
    "                'نتیجه نهایی\\nFinal Result'],\n",
    "               rows=2)\n",
    "\n",
    "print(\"✓ تشخیص خطوط جاده انجام شد\")"
   ]
