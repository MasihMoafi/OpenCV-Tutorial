    "            # نمایش نتایج\n",
    "            # Display results\n",
    "            images = [img, img_lines, img_circles]\n",
    "            titles = ['تصویر اصلی\\nOriginal',\n",
    "                      f'خطوط\\nLines ({len(lines) if lines is not None else 0})',\n",
    "                      f'دایره‌ها\\nCircles ({len(circles[0]) if circles is not None else 0})']\n",
    "            \n",
    "            display_images(images, titles)\n",
