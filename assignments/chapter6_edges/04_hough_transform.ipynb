    "            # تشخیص دایره\n",
    "            # Circle detection\n",
    "            blurred = cv2.GaussianBlur(gray, (9, 9), 2)\n",
    "            circles = cv2.HoughCircles(blurred, cv2.HOUGH_GRADIENT, 1, 50,\n",
