    "## 8. کاربرد عملی: شمارش سکه‌ها / Practical Application: Coin Counting"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def count_coins(image: np.ndarray) -> Tuple[int, np.ndarray]:\n",
    "    \"\"\"\n",
    "    شمارش سکه‌ها در تصویر\n",
    "    \n",
    "    Args:\n",
    "        image: تصویر ورودی (خاکستری)\n",
    "    \n",
    "    Returns:\n",
    "        تعداد سکه‌ها و تصویر با سکه‌های علامت‌گذاری شده\n",
    "    \"\"\"\n",
    "    # محو برای کاهش نویز\n",
    "    # Blur to reduce noise\n",
    "    blurred = cv2.GaussianBlur(image, (9, 9), 2)\n",
    "    \n",
    "    # تشخیص دایره‌ها\n",
    "    # Detect circles\n",
    "    circles = cv2.HoughCircles(blurred,\n",
    "                               cv2.HOUGH_GRADIENT,\n",
    "                               dp=1,\n",
    "                               minDist=50,\n",
    "                               param1=50,\n",
    "                               param2=30,\n",
    "                               minRadius=20,\n",
    "                               maxRadius=80)\n",
    "    \n",
    "    result_image = cv2.cvtColor(image, cv2.COLOR_GRAY2BGR)\n",
    "    coin_count = 0\n",
    "    \n",
    "    if circles is not None:\n",
    "        circles = np.uint16(np.around(circles))\n",
    "        coin_count = len(circles[0])\n",
    "        \n",
    "        for i, circle in enumerate(circles[0]):\n",
    "            x, y, r = circle\n",
    "            \n",
    "            # رسم دایره\n",
    "            # Draw circle\n",
    "            cv2.circle(result_image, (x, y), r, (0, 255, 0), 3)\n",
    "            cv2.circle(result_image, (x, y), 2, (0, 0, 255), 3)\n",
    "            \n",
    "            # شماره‌گذاری\n",
    "            # Numbering\n",
    "            cv2.putText(result_image, str(i+1), (x-10, y+5),\n",
    "                        cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255, 0, 0), 2)\n",
    "    \n",
    "    # نوشتن تعداد کل\n",
    "    # Write total count\n",
    "    cv2.putText(result_image, f'Total: {coin_count}', (10, 30),\n",
    "                cv2.FONT_HERSHEY_SIMPLEX, 1, (255, 255, 255), 2)\n",
    "    \n",
    "    return coin_count, result_image\n",
    "\n",
    "\n",
    "# ایجاد تصویر با سکه‌های شبیه‌سازی شده\n",
    "# Create image with simulated coins\n",
    "coin_image = np.zeros((500, 700), dtype=np.uint8)\n",
    "\n",
    "# اضافه کردن سکه‌ها با اندازه‌های مختلف\n",
    "# Add coins with different sizes\n",
    "np.random.seed(42)\n",
    "coin_positions = [\n",
    "    (100, 100, 50), (250, 120, 45), (400, 100, 55),\n",
    "    (550, 130, 48), (150, 280, 52), (320, 300, 47),\n",
    "    (500, 280, 50), (180, 420, 46), (450, 400, 53)\n",
    "]\n",
    "\n",
    "for x, y, r in coin_positions:\n",
    "    cv2.circle(coin_image, (x, y), r, 200, -1)\n",
    "    # اضافه کردن جزئیات\n",
    "    # Add details\n",
    "    cv2.circle(coin_image, (x, y), int(r*0.7), 150, 2)\n",
    "\n",
    "# اضافه کردن نویز\n",
    "# Add noise\n",
    "noise = np.random.normal(0, 10, coin_image.shape)\n",
    "noisy_coins = np.clip(coin_image.astype(np.float64) + noise, 0, 255).astype(np.uint8)\n",
    "\n",
    "# شمارش سکه‌ها\n",
    "# Count coins\n",
    "count, result = count_coins(noisy_coins)\n",
    "\n",
    "display_images([cv2.cvtColor(coin_image, cv2.COLOR_GRAY2BGR), result],\n",
    "               ['تصویر اصلی\\nOriginal', f'سکه‌های شمارش شده: {count}\\nCounted Coins: {count}'])\n",
    "\n",
    "print(f\"✓ تعداد سکه‌های یافت شده / Coins found: {count}\")"
   ]
  },
